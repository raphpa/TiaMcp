<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tests for TiaMcp.Formats. They run without TIA Portal: never reference the Openness project. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TiaMcp.Formats\TiaMcp.Formats.csproj" />
    <Using Include="TiaMcp.Formats" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Samples\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
